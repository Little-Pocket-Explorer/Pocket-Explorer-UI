{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "cards": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "subject": {
            "type": "string",
            "enum": [
              "duck",
              "leaf",
              "shell"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "subject",
          "title",
          "question",
          "observation",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "chapters": {
      "minItems": 3,
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "subject": {
            "type": "string",
            "enum": [
              "duck",
              "leaf",
              "shell"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "subject"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "cards",
    "chapters"
  ],
  "additionalProperties": false
}
