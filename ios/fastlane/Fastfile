require "base64"
require "fileutils"
require "json"
require "open3"
require "plist"
require "securerandom"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Upload the tested main revision and verify internal TestFlight distribution"
  lane :beta do
    UI.user_error!("Release only from main on GitHub Actions") unless
      ENV["GITHUB_ACTIONS"] == "true" && ENV["GITHUB_REF"] == "refs/heads/main"

    release_beta(local: false)
  end

  desc "Archive and upload from this Mac without a GitHub runner"
  lane :beta_local do
    UI.user_error!("Use beta for GitHub releases") if ENV["GITHUB_ACTIONS"] == "true"
    UI.user_error!("Set an absolute local release directory") unless ENV.fetch("POCKET_RELEASE_DIR").start_with?("/")
    release_beta(local: true)
  end

  private_lane :release_beta do |options|
    local_release = options[:local]
    source_id = ENV.fetch(local_release ? "POCKET_RELEASE_SOURCE" : "GITHUB_SHA")
    original_keychains = nil
    installed_profile = nil
    profile_backup = nil
    keychain = nil
    app_id = ENV.fetch("APP_STORE_CONNECT_APP_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    bundle_id = "com.haichang.pocketexplorer"
    group_id = "61f0eb50-fc33-4ee4-93fd-2844342c7584"
    temp = ENV.fetch(local_release ? "POCKET_RELEASE_DIR" : "RUNNER_TEMP")
    signing = File.join(temp, "pocket-signing")
    FileUtils.mkdir_p(signing, mode: 0700)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      duration: 1200,
      in_house: false
    )
    app = Spaceship::ConnectAPI::App.get(app_id: app_id)
    UI.user_error!("App ID does not match the bundle") unless app.bundle_id == bundle_id
    group = app.get_beta_groups.find { |item| item.id == group_id && item.is_internal_group }
    UI.user_error!("Expected internal TestFlight group is unavailable") unless group

    builds = Spaceship::ConnectAPI::Build.all(app_id: app_id, platform: "IOS")
    numbers = builds.map { |build| Integer(build.version, 10) }
    uploads = Spaceship::ConnectAPI.get_build_uploads(app_id: app_id, limit: 200).all_pages.flat_map(&:to_models)
    numbers += uploads.map { |upload| Integer(upload.cf_build_version, 10) }
    build_number = ([5] + numbers).max + 1
    version = get_version_number(xcodeproj: "PocketExplorer.xcodeproj", target: "PocketExplorer")

    certificate = File.join(signing, "distribution.p12")
    profile_file = File.join(signing, "distribution.mobileprovision")
    File.write(certificate, Base64.strict_decode64(ENV.fetch("DISTRIBUTION_P12_BASE64")), mode: "wb", perm: 0600)
    File.write(profile_file, Base64.strict_decode64(ENV.fetch("PROVISIONING_PROFILE_BASE64")), mode: "wb", perm: 0600)
    xml, _error, status = Open3.capture3("security", "cms", "-D", "-i", profile_file)
    UI.user_error!("Cannot decode provisioning profile") unless status.success?
    profile = Plist.parse_xml(xml)
    UI.user_error!("Wrong provisioning profile") unless
      profile["Entitlements"]["application-identifier"] == "#{team_id}.#{bundle_id}" &&
      profile["ExpirationDate"].to_time > Time.now && !profile.key?("ProvisionedDevices")
    installed_profile = File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles/#{profile.fetch('UUID')}.mobileprovision")
    profile_backup = File.binread(installed_profile) if local_release && File.exist?(installed_profile)
    FileUtils.mkdir_p(File.dirname(installed_profile))
    File.write(File.join(signing, "profile-path"), installed_profile, perm: 0600)
    FileUtils.cp(profile_file, installed_profile)

    keychain = File.join(temp, "pocket-signing.keychain-db")
    if local_release
      listed, _error, status = Open3.capture3("security", "list-keychains", "-d", "user")
      UI.user_error!("Cannot preserve the local keychain search list") unless status.success?
      original_keychains = Shellwords.shellsplit(listed)
    end
    keychain_password = SecureRandom.hex(32)
    create_keychain(path: keychain, password: keychain_password, default_keychain: false,
                    unlock: true, timeout: 3600, add_to_search_list: true)
    import_certificate(certificate_path: certificate,
                       certificate_password: ENV.fetch("DISTRIBUTION_P12_PASSWORD"),
                       keychain_path: keychain, keychain_password: keychain_password,
                       log_output: false)

    ipa = build_app(
      project: "PocketExplorer.xcodeproj", scheme: "PocketExplorer", configuration: "Release",
      clean: true, export_method: "app-store", skip_profile_detection: true,
      derived_data_path: File.join(temp, "release-derived-data"),
      archive_path: File.join(temp, "PocketExplorer.xcarchive"),
      output_directory: File.join(temp, "release"),
      buildlog_path: File.join(temp, "release-logs"),
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile.fetch('Name'))}",
      export_options: {
        method: "app-store-connect", signingStyle: "manual", teamID: team_id,
        signingCertificate: "Apple Distribution", manageAppVersionAndBuildNumber: false,
        provisioningProfiles: { bundle_id => profile.fetch("Name") }
      }
    )
    if local_release && ENV["POCKET_ARCHIVE_ONLY"] == "1"
      File.write(File.join(temp, "archive-result.json"), JSON.pretty_generate({
        version: version, build_number: build_number, source_commit: source_id, ipa: ipa, uploaded: false
      }) + "\n")
      next ipa
    end
    notes = File.read(File.join(__dir__, "TESTFLIGHT_NOTES.md")).strip
    notes += "\n\nSource: #{source_id}"
    upload_to_testflight(
      api_key: api_key, app_identifier: bundle_id, apple_id: app_id, ipa: ipa,
      app_version: version, build_number: build_number.to_s, changelog: notes,
      groups: [group_id], distribute_external: false, submit_beta_review: false,
      notify_external_testers: false, skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 1800, wait_processing_interval: 30,
      reject_build_waiting_for_review: false, expire_previous_builds: false
    )

    verified = Spaceship::ConnectAPI::Build.all(app_id: app_id, version: version,
                                               build_number: build_number.to_s, platform: "IOS").first
    UI.user_error!("Uploaded build is not valid") unless verified && verified.processing_state == "VALID"
    UI.user_error!("Internal group assignment was not confirmed") unless
      group.fetch_builds.any? { |item| item.id == verified.id }
    result = {
      app_id: app_id, version: version, build_number: build_number, build_id: verified.id,
      processing_state: verified.processing_state,
      internal_state: verified.build_beta_detail&.internal_build_state,
      internal_group: group.name, source_commit: source_id,
      release_origin: local_release ? "local" : "github",
      run_url: local_release ? nil : "#{ENV.fetch('GITHUB_SERVER_URL')}/#{ENV.fetch('GITHUB_REPOSITORY')}/actions/runs/#{ENV.fetch('GITHUB_RUN_ID')}"
    }
    File.write(File.join(temp, "release-result.json"), JSON.pretty_generate(result) + "\n")
    summary_path = local_release ? File.join(temp, "release-summary.md") : ENV.fetch("GITHUB_STEP_SUMMARY")
    File.open(summary_path, "a") do |summary|
      summary.puts("TestFlight #{version} (#{build_number}) is valid and assigned to #{group.name}.")
      summary.puts("\nSource: `#{source_id}`. External review is managed separately.")
    end
  ensure
    if local_release
      if installed_profile
        if profile_backup
          File.binwrite(installed_profile, profile_backup)
        else
          FileUtils.rm_f(installed_profile)
        end
      end
      Open3.capture3("security", "delete-keychain", keychain) if keychain && File.exist?(keychain)
      Open3.capture3("security", "list-keychains", "-d", "user", "-s", *original_keychains) if original_keychains
    end
  end
end
