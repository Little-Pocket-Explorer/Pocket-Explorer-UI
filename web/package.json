{
  "name": "pocket-explorer-sharing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "vitest run --coverage",
    "test:browser": "playwright test",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "migrate:cloudflare": "wrangler d1 migrations apply pocket-explorer --remote",
    "test:cloudflare": "playwright test -c playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20260722.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
