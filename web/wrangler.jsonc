{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-explorer",
  "account_id": "2aa6a2e00e739bfba03cffdcf419356a",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [{ "name": "SHARE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://pocket.changhai.me"
  },
  "routes": [{ "pattern": "pocket.changhai.me", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pocket-explorer",
    "database_id": "3868d2a6-c38c-42b9-97f2-c6e5d3850a1c",
    "migrations_dir": "migrations"
  }]
}
